{
  "name": "skala-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "test": "node --test test/*.test.mjs",
    "preview": "vite preview",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint src vite.config.js eslint.config.js",
    "lint:eslint": "eslint src vite.config.js eslint.config.js --cache",
    "format": "prettier --write --experimental-cli src/",
    "api": "node mock-api/server.js",
    "dev:all": "node scripts/dev-all.js"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "d3-geo": "^3.1.1",
    "element-plus": "^2.14.2",
    "firebase": "^12.17.1",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.4",
    "topojson-client": "^3.1.0",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "globals": "^17.5.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "prettier": "3.8.3",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
